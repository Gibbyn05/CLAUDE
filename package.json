{
  "name": "kling-vekst-promo",
  "version": "1.0.0",
  "description": "Kling Vekst SaaS marketing video — Remotion composition",
  "scripts": {
    "start": "remotion studio",
    "render": "remotion render KlingVekst-Vertical-Dark out/KlingVekstPromo.mp4 --browser-executable=/root/.cache/ms-playwright/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "render:hm": "remotion render KlingVekst-HighMotion-9x16 out/KlingVekstHighMotion.mp4 --browser-executable=/root/.cache/ms-playwright/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "render:dp": "remotion render KlingVekst-Dark-Premium-9x16 out/KlingVekstDarkPremium.mp4 --browser-executable=/root/.cache/ms-playwright/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "build": "remotion render KlingVekst-Vertical-Dark out/KlingVekstPromo.mp4 --browser-executable=/root/.cache/ms-playwright/chromium_headless_shell-1194/chrome-linux/headless_shell --gl=angle",
    "render:reachr": "remotion render Reachr-16x9 out/reachr.mp4 --browser-executable=/root/.cache/ms-playwright/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "render:reachr-v": "remotion render Reachr-9x16 out/reachr-vertical.mp4 --browser-executable=/root/.cache/ms-playwright/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "render:video": "remotion render ReachrVideo out/reachr-video.mp4 --browser-executable=/root/.cache/ms-playwright/chromium_headless_shell-1194/chrome-linux/headless_shell"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "remotion": "^4.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "typescript": "^5.0.0"
  }
}
